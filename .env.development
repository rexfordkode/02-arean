NODE_ENV=development
PORT=8000
JWT_EXPIRATION=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=auth-dashboard-dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Full URL (will be constructed from above)
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
